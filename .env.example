# Copy only the variables needed for the profile you are running into .env.local.
# All credentials below are unmistakable placeholders; never replace these in Git.

# Local PostgreSQL profile
SPRING_PROFILES_ACTIVE=local
DOCKER_COMPOSE_ENABLED=true
POSTGRES_DB=coach_gym
POSTGRES_USER=coach_gym_app
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
POSTGRES_HOST_PORT=5433
DATABASE_URL=jdbc:postgresql://localhost:5433/coach_gym
DATABASE_USERNAME=coach_gym_app
DATABASE_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
DATABASE_MAX_POOL_SIZE=5
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email is disabled by default. Use a dedicated sender account for opt-in tests.
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=REPLACE_WITH_VERIFIED_SENDER_ADDRESS
EMAIL_FROM_NAME=Coach Gym
GMAIL_API_BASE_URL=https://gmail.googleapis.com
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_SENDER_ADDRESS=REPLACE_WITH_DEDICATED_GMAIL_SENDER_ADDRESS
GMAIL_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=REPLACE_WITH_GOOGLE_OAUTH_REFRESH_TOKEN
GMAIL_CONNECT_TIMEOUT=PT5S
GMAIL_READ_TIMEOUT=PT15S
GMAIL_WRITE_TIMEOUT=PT15S
EMAIL_MAX_ATTACHMENT_BYTES=10485760
EMAIL_MAX_MESSAGE_BYTES=12582912
GOOGLE_OAUTH_EXPIRY_SAFETY_MARGIN=PT60S
GOOGLE_OAUTH_REFRESH_WAIT_TIMEOUT=PT20S
GMAIL_LIVE_TESTS_ENABLED=false
GMAIL_LIVE_TEST_RECIPIENT=recipient@example.test
GMAIL_LIVE_TEST_RECIPIENT_ALLOWLIST=recipient@example.test

# Stripe Sandbox only. Keep disabled except during an intentional local test.
STRIPE_ENABLED=false
STRIPE_SANDBOX=true
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SANDBOX_SECRET_KEY
STRIPE_WEBHOOK_SIGNING_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel
STRIPE_CONNECT_TIMEOUT=PT5S
STRIPE_READ_TIMEOUT=PT15S
STRIPE_WEBHOOK_TOLERANCE=PT5M
STRIPE_MAX_WEBHOOK_PAYLOAD_BYTES=262144
STRIPE_MAX_SIGNATURE_HEADER_LENGTH=1024

# Supabase profile. Flyway remains the only schema authority; use the Session Pooler.
# Keep this profile inactive for the normal local PostgreSQL workflow.
SUPABASE_JDBC_URL=jdbc:postgresql://REPLACE_WITH_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=REPLACE_WITH_SUPABASE_POOLER_USERNAME
SUPABASE_DB_PASSWORD=REPLACE_WITH_SUPABASE_DATABASE_PASSWORD
SUPABASE_STORAGE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=coach-gym-private
SUPABASE_STORAGE_CONNECTION_TIMEOUT=PT5S
SUPABASE_STORAGE_REQUEST_TIMEOUT=PT30S

# Bootstrap is intentionally disabled in normal operation.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_BOOTSTRAP_PASSWORD
BOOTSTRAP_ADMIN_FIRST_NAME=Local
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
