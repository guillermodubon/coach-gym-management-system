          { "$ref": "#/components/schemas/AuthorizedBranchSummary" },
          { "$ref": "#/components/schemas/OpenApiNullValue" }
        ]
      },
      "AuthorizedBranchSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "organizationId": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "timezone": { "type": "string" },
          "initialBranch": { "type": "boolean" }
        },
        "required": [
