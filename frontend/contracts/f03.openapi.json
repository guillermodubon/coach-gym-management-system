          "id",
          "initialBranch",
          "name",
          "organizationId",
          "timezone"
        ]
      },
      "OpenApiNullValue": { "type": "null" },
      "SelectActiveBranchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "branchId": { "type": "string", "format": "uuid" } },
        "required": ["branchId"]
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "description": "Server-side authenticated\nsession established by\nPOST /api/v1/auth/login.\n",
