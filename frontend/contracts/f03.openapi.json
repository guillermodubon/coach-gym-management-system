          "version": { "type": "integer", "format": "int64" }
        },
        "required": ["reason", "version"]
      },
      "StaffBranchContextResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "organizationId": { "type": "string", "format": "uuid" },
          "scopeType": { "type": "string", "enum": ["ORGANIZATION", "BRANCH"] },
          "activeBranch": {
            "$ref": "#/components/schemas/NullableAuthorizedBranchSummary",
            "description": "Present with null when no active branch is selected."
          },
          "availableBranches": {
            "type": "array",
