{
  "openapi": "3.1.0",
  "info": {
    "title": "Coach Gym - F01 HTTP contracts",
    "version": "v1",
    "description": "Proyección de las seis operaciones de F01 desde Springdoc. Los esquemas conservan la forma exportada por el backend."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get a CSRF token for state-changing requests",
        "description": "Returns a token for the caller to send in the configured CSRF header. The token is never accepted or transported in a query string.",
        "operationId": "csrf",
        "responses": {
          "200": {
            "description": "CSRF token returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create an authenticated server-side session",
        "description": "Requires a valid CSRF token. Credentials are used only for this request and are never included in the response.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Authentication succeeded"
          },
          "400": {
            "description": "Malformed or invalid login request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "403": {
            "description": "Valid CSRF token required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the configured limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "429": {
            "description": "Login attempts are temporarily rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get the current authenticated staff account",
        "description": "Returns the authenticated ADMIN or RECEPTIONIST identity and its server-resolved branch context. A missing active branch is represented as a present null value.",
        "operationId": "currentUser",
        "responses": {
          "200": {
            "description": "Current staff account returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or session expired",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "409": {
            "description": "Current branch context is unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Invalidate the current server-side session",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session invalidated"
          },
          "401": {
            "description": "Authentication required or session expired",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "403": {
            "description": "Valid CSRF token required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v1/me/profile/password": {
      "post": {
        "tags": ["Staff self-profile"],
        "summary": "Change the authenticated staff password",
        "description": "Requires the current password, the configured password policy, confirmation, and CSRF. The current session requires reauthentication; password values are never returned.",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeStaffPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffPasswordChangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid password or confirmation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "403": {
            "description": "Valid CSRF token required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "404": {
            "description": "Authenticated staff profile or credential was not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the configured limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "500": {
            "description": "Staff profile data could not be updated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/v1/me/branch-context": {
      "get": {
        "tags": ["Active branch context"],
        "summary": "Get the authenticated branch context",
        "description": "Returns the server-authoritative organization scope, current active branch and active branches available to the authenticated ADMIN or RECEPTIONIST. The selected branch never grants authorization by itself.",
        "operationId": "get",
        "responses": {
          "200": {
            "description": "Branch context returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffBranchContextResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "403": {
            "description": "Password change required before reading operational context",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          },
          "409": {
            "description": "Selected branch is no longer available",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblemResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CsrfTokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "description": "Token value returned to the caller for the configured CSRF header."
          },
          "headerName": {
            "type": "string",
            "description": "HTTP header name expected by the CSRF filter."
          },
          "parameterName": {
            "type": "string",
            "description": "Form parameter name supported by the CSRF filter; this is not a query parameter."
          }
        },
        "required": ["headerName", "parameterName", "token"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Staff username or email address.",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "description": "Staff account password.",
            "maxLength": 256,
            "minLength": 0,
            "writeOnly": true
          }
        },
        "required": ["identifier", "password"]
      },
      "ApiProblemResponse": {
        "type": "object",
        "additionalProperties": true,
        "description": "RFC 9457 error response with stable Coach Gym code and timestamp extensions.",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Problem type identifier."
          },
          "title": {
            "type": "string",
            "description": "HTTP reason phrase."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "Safe problem description."
          },
          "instance": {
            "type": "string",
            "format": "uri",
            "description": "Request URI when available."
          },
          "code": {
            "type": "string",
            "description": "Stable application error code."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Time the problem was created."
          },
          "correlationId": {
            "type": "string",
            "description": "Request correlation identifier when available."
          }
        },
        "required": ["code", "detail", "status", "timestamp", "title", "type"]
      },
      "CurrentUserResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "description": "Non-null staff role codes.",
            "items": {
              "type": "string"
            }
          },
          "organizationScope": {
            "type": "string",
            "enum": ["ORGANIZATION", "BRANCH"]
          },
          "activeBranch": {
            "$ref": "#/components/schemas/NullableAuthorizedBranchSummary",
            "description": "Present with null when no active branch is selected or available."
          },
          "availableBranches": {
            "type": "array",
            "description": "Non-null active branches available to the authenticated staff account.",
            "items": {
              "$ref": "#/components/schemas/AuthorizedBranchSummary"
            }
          },
          "passwordChangeRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "activeBranch",
          "availableBranches",
          "fullName",
          "id",
          "organizationScope",
          "passwordChangeRequired",
          "roles",
          "username"
        ]
      },
      "NullableAuthorizedBranchSummary": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/AuthorizedBranchSummary"
          },
          {
            "$ref": "#/components/schemas/OpenApiNullValue"
          }
        ]
      },
      "AuthorizedBranchSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "initialBranch": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "id",
          "initialBranch",
          "name",
          "organizationId",
          "timezone"
        ]
      },
      "OpenApiNullValue": {
        "type": "null"
      },
      "ChangeStaffPasswordRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "Current staff account password.",
            "minLength": 1,
            "writeOnly": true
          },
          "newPassword": {
            "type": "string",
            "description": "New staff account password.",
            "minLength": 1,
            "writeOnly": true
          },
          "newPasswordConfirmation": {
            "type": "string",
            "description": "Confirmation of the new password.",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "currentPassword",
          "newPassword",
          "newPasswordConfirmation"
        ]
      },
      "StaffPasswordChangeResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "profileVersion": {
            "type": "integer",
            "format": "int64"
          },
          "reauthenticationRequired": {
            "type": "boolean"
          }
        },
        "required": ["profileVersion", "reauthenticationRequired", "userId"]
      },
      "StaffBranchContextResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "scopeType": {
            "type": "string",
            "enum": ["ORGANIZATION", "BRANCH"]
          },
          "activeBranch": {
            "$ref": "#/components/schemas/NullableAuthorizedBranchSummary",
            "description": "Present with null when no active branch is selected."
          },
          "availableBranches": {
            "type": "array",
            "description": "Non-null active branches available to the authenticated staff account.",
            "items": {
              "$ref": "#/components/schemas/AuthorizedBranchSummary"
            }
          }
        },
        "required": [
          "activeBranch",
          "availableBranches",
          "organizationId",
          "scopeType"
        ]
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "description": "Server-side authenticated\nsession established by\nPOST /api/v1/auth/login.\n",
        "name": "JSESSIONID",
        "in": "cookie"
      }
    }
  }
}
