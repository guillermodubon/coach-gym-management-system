{
  "name": "coach-gym-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "tools/contracts"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <13.0.0"
  },
  "scripts": {
    "dev": "npm run types:generate && vite",
    "preview": "vite preview",
    "types:generate": "node tools/contracts/generate.mjs",
    "types:check": "node tools/contracts/generate.mjs --check",
    "contracts:capture": "node tools/contracts/capture.mjs",
    "typecheck": "npm run types:generate && tsc --build --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test:run": "npm run types:generate && vitest run && node --test tools/contracts/scope.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:integration": "node tools/integration/run.mjs",
    "test:e2e:integration:browser": "playwright test --config=playwright.integration.config.ts",
    "build": "npm run typecheck && vite build",
    "check": "npm run types:check && npm run typecheck && npm run lint && npm run format:check && npm run test:run"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.104.3",
    "antd": "6.6.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bcryptjs": "3.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
